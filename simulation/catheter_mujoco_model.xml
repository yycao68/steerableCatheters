<mujoco model="catheter_prb_spike">
  <compiler angle="radian" autolimits="true"/>
  <!-- dt=2e-5: the analytic Kelvin-Voigt tissue force is applied explicitly on a very
       light tip; a stiff k_t=5000 contact needs this step for explicit stability. -->
  <option timestep="2e-5" integrator="implicitfast" cone="elliptic"/>
  <default>
    <site rgba="1 1 0 1"/>
  </default>
  <worldbody>
    <geom name="floor" type="plane" pos="0 0 -0.05" size="1 1 0.01"
          contype="0" conaffinity="0" rgba="0.9 0.9 0.9 1"/>
    <site name="anchor" pos="0 0 -0.00115" size="0.0005"/>
    <!-- catheter base fixed to world; chain extends +x, bends in x-z plane -->
    <body name="link0" pos="0 0 0">
      <joint name="j0" type="hinge" axis="0 1 0" pos="0 0 0" stiffness="0.047999999999999994" damping="0.0002" armature="2e-5"/>
      <geom type="capsule" fromto="0 0 0 0.00625 0 0" size="0.00115" mass="2.5e-05" contype="0" conaffinity="0" rgba="0.3 0.5 0.9 1"/>
      <site name="t0" pos="0.003125 0 -0.00115" size="0.0005"/>
    <body name="link1" pos="0.00625 0 0">
      <joint name="j1" type="hinge" axis="0 1 0" pos="0 0 0" stiffness="0.047999999999999994" damping="0.0002" armature="2e-5"/>
      <geom type="capsule" fromto="0 0 0 0.00625 0 0" size="0.00115" mass="2.5e-05" contype="0" conaffinity="0" rgba="0.3 0.5 0.9 1"/>
      <site name="t1" pos="0.003125 0 -0.00115" size="0.0005"/>
    <body name="link2" pos="0.00625 0 0">
      <joint name="j2" type="hinge" axis="0 1 0" pos="0 0 0" stiffness="0.047999999999999994" damping="0.0002" armature="2e-5"/>
      <geom type="capsule" fromto="0 0 0 0.00625 0 0" size="0.00115" mass="2.5e-05" contype="0" conaffinity="0" rgba="0.3 0.5 0.9 1"/>
      <site name="t2" pos="0.003125 0 -0.00115" size="0.0005"/>
    <body name="link3" pos="0.00625 0 0">
      <joint name="j3" type="hinge" axis="0 1 0" pos="0 0 0" stiffness="0.047999999999999994" damping="0.0002" armature="2e-5"/>
      <geom type="capsule" fromto="0 0 0 0.00625 0 0" size="0.00115" mass="2.5e-05" contype="0" conaffinity="0" rgba="0.3 0.5 0.9 1"/>
      <site name="t3" pos="0.003125 0 -0.00115" size="0.0005"/>
    <body name="link4" pos="0.00625 0 0">
      <joint name="j4" type="hinge" axis="0 1 0" pos="0 0 0" stiffness="0.047999999999999994" damping="0.0002" armature="2e-5"/>
      <geom type="capsule" fromto="0 0 0 0.00625 0 0" size="0.00115" mass="2.5e-05" contype="0" conaffinity="0" rgba="0.3 0.5 0.9 1"/>
      <site name="t4" pos="0.003125 0 -0.00115" size="0.0005"/>
    <body name="link5" pos="0.00625 0 0">
      <joint name="j5" type="hinge" axis="0 1 0" pos="0 0 0" stiffness="0.047999999999999994" damping="0.0002" armature="2e-5"/>
      <geom type="capsule" fromto="0 0 0 0.00625 0 0" size="0.00115" mass="2.5e-05" contype="0" conaffinity="0" rgba="0.3 0.5 0.9 1"/>
      <site name="t5" pos="0.003125 0 -0.00115" size="0.0005"/>
    <body name="link6" pos="0.00625 0 0">
      <joint name="j6" type="hinge" axis="0 1 0" pos="0 0 0" stiffness="0.047999999999999994" damping="0.0002" armature="2e-5"/>
      <geom type="capsule" fromto="0 0 0 0.00625 0 0" size="0.00115" mass="2.5e-05" contype="0" conaffinity="0" rgba="0.3 0.5 0.9 1"/>
      <site name="t6" pos="0.003125 0 -0.00115" size="0.0005"/>
    <body name="link7" pos="0.00625 0 0">
      <joint name="j7" type="hinge" axis="0 1 0" pos="0 0 0" stiffness="0.047999999999999994" damping="0.0002" armature="2e-5"/>
      <geom type="capsule" fromto="0 0 0 0.00625 0 0" size="0.00115" mass="2.5e-05" contype="0" conaffinity="0" rgba="0.3 0.5 0.9 1"/>
      <site name="t7" pos="0.003125 0 -0.00115" size="0.0005"/>
      <geom name="tip" type="sphere" size="0.00184" pos="0.00625 0 0" mass="1.25e-05" contype="1" conaffinity="1" rgba="0.9 0.2 0.2 1"/>
      <site name="tip_site" pos="0.00625 0 0" size="0.001"/>
    </body>
    </body>
    </body>
    </body>
    </body>
    </body>
    </body>
    </body>
    <!-- tissue wall: box on z-slide for cardiac motion; Kelvin-Voigt via solref -->
    <body name="wall" pos="0 0 -0.004">
      <joint name="wall_z" type="slide" axis="0 0 1" damping="1e3"/>
      <geom name="wall_geom" type="box" size="0.05 0.02 0.005" pos="0 0 -0.005"
            contype="0" conaffinity="0" rgba="0.8 0.5 0.5 0.4"/>
    </body>
  </worldbody>
  <tendon>
    <spatial name="cath_tendon" width="0.0003" rgba="0.1 0.8 0.1 1"
             frictionloss="0.0">
      <site site="anchor"/>
      <site site="t0"/>
      <site site="t1"/>
      <site site="t2"/>
      <site site="t3"/>
      <site site="t4"/>
      <site site="t5"/>
      <site site="t6"/>
      <site site="t7"/>
    </spatial>
  </tendon>
  <actuator>
    <motor name="tendon_motor" tendon="cath_tendon" gear="1"
           ctrlrange="-8.0 0" ctrllimited="true"/>
    <position name="wall_drive" joint="wall_z" kp="2e4" ctrlrange="-0.06 0.01"/>
  </actuator>
  <sensor>
    <framepos name="tip_pos" objtype="site" objname="tip_site"/>
    <framelinvel name="tip_vel" objtype="site" objname="tip_site"/>
    <tendonpos name="tendon_len" tendon="cath_tendon"/>
  </sensor>
</mujoco>